# Expand every shared shader include at build time without a Python dependency.
if(NOT DEFINED INPUT_ROOT)
    message(FATAL_ERROR "INPUT_ROOT is required")
endif()
set(output "/* Generated by tools/embed_qpr2_gpu_shader.cmake. */\n")
set(files nv2a_gpu_raster.hlsl nv2a_gpu_rov.hlsl nv2a_gpu_report_reset.hlsl nv2a_gpu_coverage.hlsl nv2a_gpu_clear.hlsl nv2a_gpu_geometry.hlsl nv2a_gpu_texcopy.hlsl)
set(symbols nv_gpu_shader_source nv_gpu_rov_source nv_gpu_report_reset_source nv_gpu_coverage_source nv_gpu_clear_source nv_gpu_geometry_source nv_gpu_texcopy_source)
foreach(index RANGE 0 6)
    list(GET files ${index} name)
    list(GET symbols ${index} symbol)
    file(READ "${INPUT_ROOT}/${name}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    foreach(inc nv2a_gpu_types.h nv2a_gpu_pixel.inc nv2a_gpu_literal.inc nv2a_gpu_compact.inc nv2a_gpu_shade.inc nv2a_gpu_source.inc nv2a_gpu_raw_types.h nv2a_gpu_vsh.inc nv2a_gpu_prepare.inc)
        file(READ "${INPUT_ROOT}/${inc}" body)
        string(REPLACE "\r\n" "\n" body "${body}")
        string(REPLACE "#include \"${inc}\"" "${body}" source "${source}")
    endforeach()
    string(LENGTH "${source}" source_bytes)
    # MSVC limits concatenated string literals. Larger sources use an ordinary
    # byte-array initializer; compiler inputs/hash bytes stay exactly the same.
    if(source_bytes GREATER 60000)
        string(HEX "${source}" source_hex)
        string(APPEND output "static const char ${symbol}[] =\n{\n")
        math(EXPR final_offset "${source_bytes} * 2 - 1")
        foreach(offset RANGE 0 ${final_offset} 64)
            string(SUBSTRING "${source_hex}" ${offset} 64 block)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," block "${block}")
            string(APPEND output "${block}\n")
        endforeach()
        string(APPEND output "0x00};\n")
    else()
    string(REPLACE "\\" "\\\\" source "${source}")
    string(REPLACE "\"" "\\\"" source "${source}")
    string(REPLACE "\t" "\\t" source "${source}")
    string(REPLACE "\n" "\\n\"\n\"" source "${source}")
    string(APPEND output "static const char ${symbol}[] =\n\"${source}\";\n")
    endif()
endforeach()
set(dest "${INPUT_ROOT}/nv2a_gpu_shader.h")
set(previous "")
if(EXISTS "${dest}")
    file(READ "${dest}" previous)
endif()
if(NOT output STREQUAL previous)
    file(WRITE "${dest}" "${output}")
endif()
